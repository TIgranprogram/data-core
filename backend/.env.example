NODE_ENV=development
PORT=3000

# MongoDB (Replica Set required for transactions)
MONGO_URI=mongodb://localhost:27017/kppdf?replicaSet=rs0
MONGO_DB=kppdf
MONGO_REPLICA_SET=rs0

# CORS — prefer CORS_ORIGIN (compose/prod). CORS_ORIGINS = legacy alias.
# Comma-separated origins. Prod canon: https://kppdf-crm.ru
CORS_ORIGIN=http://localhost:3000,http://localhost:4200
# CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# Logging — default quiet boot (TZ-OPS-301). Nest DI dump: LOG_LEVEL=debug or NEST_BOOT_VERBOSE=1
LOG_LEVEL=info
# NEST_BOOT_VERBOSE=1

# JWT — REPLACE before any production deploy (≥32 chars each, MUST differ)
JWT_SECRET=REPLACE_ME_dev_only_min_32_chars_xxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_ME_different_from_access_secret
JWT_REFRESH_EXPIRES_IN=30d
# Alias: JWT_REFRESH_TOKEN_TTL (same meaning)

# Default admin (seed). Local/dev: any ≥8. Production compose REQUIRES env
# and bans demo default `admin-change-me-immediately-in-production`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME_local_dev_only_12chars

# Throttler (rate limiting)
# THROTTLE_TTL_SHORT=1000  # window in ms
# THROTTLE_LIMIT_SHORT=10
# THROTTLE_TTL_LONG=60000
# THROTTLE_LIMIT_LONG=100
# DISABLE_THROTTLE=1
