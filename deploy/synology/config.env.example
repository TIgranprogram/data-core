# Personal Data Core - конфиг деплоя (копируется в config.env, в git НЕ попадает)
# copy deploy\synology\config.env.example deploy\synology\config.env
#
# Пароли Mongo здесь обязаны быть заполнены: docker-compose.prod.yml требует
# их (?required), а root-пароль нужен backup.sh и инициализации rs0.
# Генерация: python -c "import secrets;print(secrets.token_urlsafe(32))"

PLATFORM=ubuntu

# LAN Synology Ubuntu VM (без VPN недоступен - отключи VPN)
DEPLOY_HOST=<LAN_IP>
DEPLOY_USER=<SSH_USER>
# DEPLOY_PASSWORD=
# Prefer key auth after first install:
# DEPLOY_SSH_KEY=C:\Users\YOU\.ssh\<SSH_KEY_NAME>

# Каталог приложения (переопределяет дефолт платформы)
REMOTE_DIR=/opt/data-core
# Каталог данных: Mongo + uploads + backups
DATA_DIR=/var/lib/datacore

JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_64_HEX
# Required in production (NOT the demo default)
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- Mongo auth (задача B, P0.4) ---
# root: инит rs0 + бэкапы (mongodump); datacore: приложение (readWrite)
MONGO_ROOT_PASSWORD=CHANGE_ME_RANDOM_32_PLUS
MONGO_APP_PASSWORD=CHANGE_ME_RANDOM_32_PLUS
# Секрет keyfile (обязателен: --auth + replica set). 400+ символов base64:
# python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(384)).decode().rstrip('=\\n='))"
MONGO_KEYFILE_SECRET=CHANGE_ME_LONG_RANDOM_BASE64
# Если MONGO_URI не задан, deploy.py соберёт его сам из MONGO_APP_PASSWORD:
# MONGO_URI=mongodb://datacore:<password>@mongo:27017/datacore?replicaSet=rs0&authSource=datacore

# Публичный origin API (для локальной VM достаточно IP)
CORS_ORIGIN=http://<LAN_IP>:3001

# WIPE=true   # останавливает контур, чистит REMOTE_DIR + mongo data (dev-only!)
