# === Personal Data Core — скопируй в .env и заполни ===
# .env в git не попадает (.gitignore).

# Каталог на хосте, где живут данные (MongoDB + загруженные файлы)
DATA_DIR=/opt/datacore

NODE_ENV=production
PORT=3000

# MongoDB — обязателен Replica Set rs0 (транзакции/счётчики)
MONGO_URI=mongodb://datacore:CHANGE_ME@mongo:27017/datacore?replicaSet=rs0&authSource=datacore
# Mongo --auth (задача B): root — init/бэкапы, datacore — приложение
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=datacore
MONGO_APP_PASSWORD=
# Keyfile-секрет (обязателен при --auth + replica set; сгенерируй 400+ символов)
MONGO_KEYFILE_SECRET=
MONGO_DB=datacore
MONGO_REPLICA_SET=rs0

# CORS — какие origin'ы могут дёргать API (через запятую)
CORS_ORIGIN=http://localhost:3000

# JWT — сгенерируй ≥32 символа каждый, секреты ДОЛЖНЫ отличаться друг от друга
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Первый (seed) администратор — логин = ADMIN_USERNAME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

LOG_LEVEL=info

# Swagger UI в prod выключен; включать только точечно для отладки
# SWAGGER_ENABLED=true
