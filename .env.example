# === Personal Data Core — скопируй в .env и заполни ===
# .env в git не попадает (.gitignore).

# Каталог на хосте, где живут данные (MongoDB + загруженные файлы)
DATA_DIR=/opt/datacore

NODE_ENV=production
PORT=3000

# --- Только для локального docker-compose.yml (на VM порты зашиты в docker-compose.prod.yml) ---
# Порт API на хосте (внутри контейнера всегда PORT=3000). Дефолт compose — 3000;
# в этом проекте принят 3001, чтобы не конфликтовать с kppdf на :3000.
# HOST_PORT=3001
# Порт Mongo на хосте (публикуется только на 127.0.0.1). Дефолт 27017 — смени,
# если 27017 занят другим Mongo (например, kppdf).
# MONGO_PORT=27018
# Образ Mongo (используется и в docker-compose.prod.yml). Дефолт mongo:4.4 —
# VM без AVX не запускает 5.0+. На AVX-железе можно mongo:7 (после restore-дрилла).
# MONGO_IMAGE=mongo:4.4

# MongoDB — обязателен Replica Set rs0 (транзакции/счётчики)
MONGO_URI=mongodb://datacore:CHANGE_ME@mongo:27017/datacore?replicaSet=rs0&authSource=datacore
# Mongo --auth (задача B): root — init/бэкапы, datacore — приложение
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=datacore
MONGO_APP_PASSWORD=
# Keyfile-секрет (обязателен при --auth + replica set; сгенерируй 400+ символов)
MONGO_KEYFILE_SECRET=
MONGO_DB=datacore
MONGO_REPLICA_SET=rs0

# CORS — какие origin'ы могут дёргать API (через запятую)
CORS_ORIGIN=http://localhost:3000

# JWT — сгенерируй ≥32 символа каждый, секреты ДОЛЖНЫ отличаться друг от друга
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Первый (seed) администратор — логин = ADMIN_USERNAME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

LOG_LEVEL=info

# Swagger UI в prod выключен; включать только точечно для отладки
# SWAGGER_ENABLED=true
