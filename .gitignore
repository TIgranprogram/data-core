node_modules/
dist/
coverage/
# Runtime uploads dir (только в корне/бэкенде) — НЕ использовать голое "uploads/",
# оно матчит и src/modules/uploads/ и вырезает модуль из git (инцидент 2026-10-17).
/uploads/
backend/uploads/
*.log
.env
.env.local
.DS_Store

# Локальные данные MongoDB/uploads (Docker bind mount)
.data/

# Локальные секреты (копируются вручную при переносе на новую машину/клон)
deploy/synology/config.env
deploy/synology/CREDENTIALS.md

# Claude Code — личные настройки
.claude/settings.local.json

# Рабочие выгрузки пользователя (бизнес-данные) — не в git
/для анализа/

# Ключ сервисного аккаунта Google (чтение Google-таблиц) — никогда не коммитить
secrets/
*google-sa*.json

# Ключ «рабочий ПК» для выкладки с работы — секрет, никогда не коммитить
/remote-access/secret/

# Доступ к деплою с рабочего ПК (ключи, ssh_config) — не в git
/deploy/remote-access/

# рабочие копии агентов Claude Code
.claude/worktrees/

# доступ агента datacore-access (локальный пароль, если сменён в админке)
deploy/synology/access.env

# образцы Excel — не хранить в git (бинарники, меняются)
docs/samples/*.xlsx
docs/samples/*.xls

# архив деплоя (создаётся datacore-deploy, не хранить в git)
release.tgz

tools/logs/

# Локальный ИИ (C019): URL/ключ и готовые Excel — только на ПК
tools/local-ai-order/settings.json
tools/local-ai-order/out/*
!tools/local-ai-order/out/README.md
tools/local-ai-order/inbox/*
!tools/local-ai-order/inbox/README.md

# Ночной стенд и прогоны dc night (секреты стенда, worktree, итоги)
tools/.night/

# Локальные материалы сессии: снимки до правок, тестовые дампы, отчёты и итоговые файлы
/.work/
/outputs/
tools/ai-tester/settings.json

# Выгрузки с прода для заданий crew — только локально (данные, не код)
docs/crew/*/data/
# Личные тестовые материалы пользователя — только локально

# Рабочие файлы заказов пользователя (КП, картинки, разовые скрипты) — не в git
/Заказы для оформления на сайт/

# Каталог и выгрузки для внедрения (бизнес-данные) — не в git
/данные для анализа и внедрения/
